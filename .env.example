# Precifarm Agent — server chat (/api/agent/chat)
# OpenRouter is used when OPENROUTER_API_KEY is set; otherwise direct DeepSeek.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=deepseek/deepseek-v4-flash

# DeepSeek direct (fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: forward chat to a local OpenCode server instead of the model provider
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# AGENT_PREFER_OPENCODE=true
