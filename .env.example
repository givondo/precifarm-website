# PreciFarm website — environment template
# Copy to .env.local and fill in values. Never commit .env.local.
# Full reference: ../docs/infrastructure/environment.md

# --- Public URLs (non-secret) ---

# Canonical site URL (SEO, sitemap, Open Graph). Production: https://precifarm.com
NEXT_PUBLIC_SITE_URL=https://precifarm.com

# CMS API base. Unset = in-memory demo store (resets on restart).
# Local shared inventory: http://localhost:3002/api
# Production: https://api.precifarm.com/api
CMS_API_URL=http://localhost:3002/api

# --- Optional public client vars ---

# Google Maps for /network. Omit to use Leaflet + CARTO tiles.
# Restrict key to your domain in Google Cloud Console.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# External APK URL; default serves /downloads/precifarm.apk from this deploy
# NEXT_PUBLIC_APP_APK_URL=

# Analytics environment tag: development | production
# NEXT_PUBLIC_ANALYTICS_ENVIRONMENT=development

# Google Search Console HTML tag verification (meta name="google-site-verification")
# Get token from Search Console → Settings → Ownership verification → HTML tag
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Semi-sensitive / server-side ---

# Android App Links — production signing cert SHA-256 (public fingerprint, not the private key)
# ANDROID_APP_SHA256=AA:BB:CC:...

# Analytics proxy → CMS ingest (must match CMS ANALYTICS_INGEST_KEY)
# ANALYTICS_INGEST_KEY=

# --- M-Pesa (website-only mode) ---
# When CMS_API_URL is set, STK runs on the CMS. Do NOT set MPESA_* here in production.
# Configure Daraja in Ticketing and Payment CMS/.env.local instead.

# Demo payment when running without CMS (default true)
DEMO_PAYMENT=true

# Only when CMS_API_URL is unset AND DEMO_PAYMENT=false:
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=
# MPESA_ENVIRONMENT=sandbox
